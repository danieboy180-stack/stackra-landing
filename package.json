{
  "name": "stackra-landing",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/accessibility.spec.ts",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "qa": "npm run check:placeholders && npm run typecheck && npm run lint && npm run build",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "lucide-react": "1.52.0",
    "motion": "14.0.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.11.0",
    "eslint-config-next": "16.4.0",
    "playwright": "1.63.0",
    "postcss": "8.5.6",
    "prettier": "3.6.2",
    "tailwindcss": "4.3.0",
    "typescript": "5.9.3"
  }
